# =============================================================
# Vibe Mailer — Supabase Edge Function 시크릿
# =============================================================
# 로컬 개발: `supabase functions serve --env-file ./supabase/functions/.env.local`
# 프로덕션: `supabase secrets set --env-file ./supabase/functions/.env.local`
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 는
# Supabase 가 함수 실행 시 자동 주입하므로 여기에 적지 않는다.

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 발신 주소
#   - 무료티어 + 도메인 미인증: 'onboarding@resend.dev' 만 사용 가능, 수신자는 본인 이메일만
#   - 커스텀 도메인 SPF/DKIM 인증 후: 'Vibe Mailer <noreply@yourdomain.com>'
RESEND_FROM_EMAIL=Vibe Mailer <onboarding@resend.dev>

# (선택) CORS 화이트리스트. 콤마구분. 비우면 모든 origin 허용(*).
# ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000

# =============================================================
# 미소산랩 (daily-lesson Edge Function) 전용
# =============================================================
# Anthropic API 키 (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 발신 주소 (Resend). 도메인 미인증 시 'onboarding@resend.dev' 만 가능.
MISOSAN_FROM_EMAIL=미소산랩 <onboarding@resend.dev>

# 수신 주소 (본인 메일). 도메인 미인증 시 Resend 가입 이메일만 수신 가능.
MISOSAN_RECIPIENT_EMAIL=kevin017@gmail.com

# cron 호출 보호용 공유 시크릿. ml_config.cron_secret 과 동일하게 맞춘다.
# 예: openssl rand -hex 16
MISOSAN_CRON_SECRET=change-me-to-a-random-secret
