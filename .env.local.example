# =============================================================
# Vibe Mailer — Next.js 프론트엔드 환경변수 (.env.local 로 복사)
# =============================================================
# Supabase 프로젝트 대시보드 > Project Settings > API 에서 확인

# 클라이언트(브라우저)에서 사용 — anon key 공개 가능
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# 서버 사이드(Next.js Route Handler / Server Component)에서만 사용 — 절대 클라이언트 노출 금지
# 일반 운영에서는 모든 쓰기 작업이 Edge Function 경유라 필수 아님.
# 어드민 페이지에서 service_role 가 필요한 일괄 조회를 한다면 활성화.
# SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
